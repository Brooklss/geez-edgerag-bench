# Ge'ez-EdgeRAG — .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/

# Results & generated outputs
results/*.csv
results/*.json
results/*.log
!results/.gitkeep

# Model cache (can be large)
.cache/
huggingface/
*.bin
*.safetensors
*.gguf

# IDE / OS
.vscode/
.idea/
*.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Testing
.pytest_cache/
.coverage
htmlcov/

# Secrets
.env
*.key
